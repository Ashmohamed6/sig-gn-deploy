# =============================================================================
# ENV DEV - SIG GN (Docker Compose)
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (container db)
# -----------------------------------------------------------------------------
POSTGRES_DB=sig_territoires_gn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Django (container backend)
# -----------------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

DB_HOST=db
DB_PORT=5432
DB_NAME=sig_territoires_gn
DB_USER=postgres
DB_PASSWORD=postgres

DJANGO_CORS_ALLOW_ALL_ORIGINS=0
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:8000

DJANGO_PAGE_SIZE=50
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_AUTH=20/min
DRF_THROTTLE_AUTH_IDENTIFIER=25/min
DRF_THROTTLE_TOKEN_REFRESH=40/min
DRF_THROTTLE_STATS=180/min
DRF_THROTTLE_GEOJSON=240/min
DRF_THROTTLE_ADMIN_READ=300/min
DRF_THROTTLE_ADMIN_WRITE=100/min
DRF_THROTTLE_WORKFLOW_READ=300/min
DRF_THROTTLE_WORKFLOW_WRITE=120/min
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Kobo direct sync (desactive par defaut en dev)
KOBO_SYNC_ENABLED=0
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
KOBO_HTTP_TIMEOUT=20
KOBO_SYNC_MAX_RECORDS=500
KOBO_SYNC_MAX_PAYLOAD_RECORDS=200
KOBO_FORM_REGISTRY={}

# -----------------------------------------------------------------------------
# Next.js (container frontend)
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_API_URL=http://backend:8000
APP_URL=http://localhost:3001
NEXT_PUBLIC_API_HOST=http://backend:8000

# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
TZ=Africa/Conakry
