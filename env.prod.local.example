# Copiez ce fichier en `env.prod.local` (non versionne) puis remplacez
# toutes les valeurs `CHANGE_ME_*` avant de deployer.

POSTGRES_DB=sig_territoires_gn
POSTGRES_USER=siggn_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY

DJANGO_ALLOWED_HOSTS=backend,nginx,example.com,www.example.com

DB_HOST=db
DB_PORT=5432
DB_NAME=sig_territoires_gn
DB_USER=siggn_user
DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

DJANGO_CORS_ALLOW_ALL_ORIGINS=0
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

DJANGO_PAGE_SIZE=50
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_AUTH=10/min
DRF_THROTTLE_AUTH_IDENTIFIER=12/min
DRF_THROTTLE_TOKEN_REFRESH=20/min
DRF_THROTTLE_STATS=90/min
DRF_THROTTLE_GEOJSON=120/min
DRF_THROTTLE_ADMIN_READ=120/min
DRF_THROTTLE_ADMIN_WRITE=40/min
DRF_THROTTLE_WORKFLOW_READ=180/min
DRF_THROTTLE_WORKFLOW_WRITE=60/min
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0

# Kobo direct sync (activer uniquement quand configure)
KOBO_SYNC_ENABLED=0
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=CHANGE_ME_KOBO_API_TOKEN
KOBO_HTTP_TIMEOUT=20
KOBO_SYNC_MAX_RECORDS=500
KOBO_SYNC_MAX_PAYLOAD_RECORDS=200
KOBO_FORM_REGISTRY={}

NODE_ENV=production
NEXT_PUBLIC_API_BASE=/api
BACKEND_API_URL=http://backend:8000
APP_URL=https://example.com
NEXT_PUBLIC_API_HOST=http://backend:8000
TZ=Africa/Conakry
